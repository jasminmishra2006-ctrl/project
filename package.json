{
  "name": "neer-x-workspace",
  "private": true,
  "workspaces": ["frontend"],
  "scripts": {
    "dev": "concurrently -k \"npm run dev --workspace frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "python -m uvicorn app:app --app-dir backend/ml-service --host 127.0.0.1 --port 8000",
    "build": "npm run build --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "test": "python backend/ml-service/run_tests.py"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
