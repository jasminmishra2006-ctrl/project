# Backend-only values. Set strong unique tokens outside source control.
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_TOKEN=replace-with-a-long-random-admin-token
INGEST_TOKEN=replace-with-a-long-random-ingestion-token
OFFLINE_MULTIPLIER=2
